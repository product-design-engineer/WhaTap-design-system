{
  "name": "@whatap/design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "WhaTap AI Assistant design system — chrome + widget cards + tokens. Consumed as a Vercel-hosted tarball; the `source` export condition serves the DS's own Storybook/Vitest from src.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./widget": {
      "source": "./src/widget/index.ts",
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "default": "./dist/widget.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./style.css": "./dist/style.css",
    "./whatap-ds.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:design": "node scripts/build-design.mjs",
    "build:js": "tsup",
    "build:lib": "pnpm build:js",
    "release": "node scripts/pack-release.mjs",
    "storybook": "node scripts/build-design.mjs && storybook dev -p 5181 --no-open",
    "build-storybook": "node scripts/build-design.mjs && storybook build",
    "check:catalog": "node scripts/check-catalog-folders.mjs",
    "test": "node scripts/check-catalog-folders.mjs && vitest run",
    "test:visual": "node scripts/visual-snap.mjs",
    "test:visual:update": "node scripts/visual-snap.mjs --update"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.4.4",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  }
}
