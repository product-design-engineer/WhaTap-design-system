{
  "name": "@whatap/design-system",
  "version": "0.1.13",
  "private": false,
  "type": "module",
  "description": "WhaTap AI Assistant design system — chrome + widget cards + tokens. Consumed as a Vercel-hosted tarball; the `source` export condition serves the DS's own Storybook/Vitest from src.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./widget": {
      "source": "./src/widget/index.ts",
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "default": "./dist/widget.js"
    },
    "./chart": {
      "source": "./src/chart/index.ts",
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js",
      "default": "./dist/chart.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./style.css": "./dist/style.css",
    "./whatap-ds.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:design": "node scripts/build-design.mjs && node scripts/build-components-json.mjs && node scripts/build-tokens-json.mjs && node scripts/build-policies-json.mjs",
    "build:js": "tsup",
    "build:lib": "pnpm build:js",
    "release": "node scripts/pack-release.mjs",
    "storybook": "pnpm build:design && storybook dev -p 5181 --no-open",
    "build-storybook": "pnpm build:design && storybook build",
    "check:catalog": "node scripts/check-catalog-folders.mjs",
    "build:components-json": "node scripts/build-components-json.mjs",
    "lint:docstrings": "node scripts/check-docstrings.mjs",
    "lint:design": "node scripts/design-lint.js",
    "test": "node scripts/check-catalog-folders.mjs && node scripts/check-ai-boundary.mjs && node scripts/check-docstrings.mjs && node scripts/check-wikilinks.mjs && node scripts/check-token-docs.mjs && node scripts/check-policy-docs.mjs && node scripts/check-catalog-coverage.mjs && node scripts/check-figma-map.mjs && node scripts/design-lint.js && node scripts/check-no-raw-colors.mjs && node scripts/check-layer-deps.mjs && node scripts/check-token-sync.mjs && node scripts/check-chart-palette.mjs && node scripts/check-no-tailwind.mjs && node scripts/check-css-structure.mjs && node scripts/check-guardrails-meta.mjs && pnpm lint:cycles && vitest run",
    "test:visual": "node scripts/visual-snap.mjs",
    "test:visual:update": "node scripts/visual-snap.mjs --update",
    "lint:tokens": "node scripts/check-no-raw-colors.mjs",
    "audit:runtime": "node scripts/audit-runtime-policy.mjs",
    "audit:runtime:dark": "node scripts/audit-runtime-policy.mjs --theme dark",
    "lint:layers": "node scripts/check-layer-deps.mjs",
    "typecheck": "tsc --noEmit",
    "lint:token-sync": "node scripts/check-token-sync.mjs",
    "lint:chart-palette": "node scripts/check-chart-palette.mjs",
    "lint:no-tailwind": "node scripts/check-no-tailwind.mjs",
    "lint:css-structure": "node scripts/check-css-structure.mjs",
    "lint:guardrails": "node scripts/check-guardrails-meta.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint:cycles": "eslint src",
    "lint:wikilinks": "node scripts/check-wikilinks.mjs",
    "build:tokens-json": "node scripts/build-tokens-json.mjs",
    "lint:token-docs": "node scripts/check-token-docs.mjs",
    "lint:coverage": "node scripts/check-catalog-coverage.mjs",
    "lint:ai-boundary": "node scripts/check-ai-boundary.mjs",
    "build:policies-json": "node scripts/build-policies-json.mjs",
    "lint:policy-docs": "node scripts/check-policy-docs.mjs",
    "lint:figma-map": "node scripts/check-figma-map.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.4.4",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  }
}
