{
  "name": "@whatap/design-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "WhaTap AI Assistant design system — chrome + widget cards + tokens. Source-only package consumed by prototypes via workspace symlink.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./widget": {
      "types": "./src/widget/index.ts",
      "default": "./src/widget/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "src",
    "stories",
    ".storybook",
    "dist"
  ],
  "scripts": {
    "build:design": "node scripts/build-design.mjs",
    "build:js": "tsup",
    "build:css": "tailwindcss -i scripts/dist-style.css -o dist/style.css --minify",
    "build:lib": "pnpm build:js && pnpm build:css",
    "storybook": "node scripts/build-design.mjs && storybook dev -p 5181 --no-open",
    "build-storybook": "node scripts/build-design.mjs && storybook build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.4.4",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  }
}
