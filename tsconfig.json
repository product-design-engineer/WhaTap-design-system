{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    /* 스토리는 소비자와 같은 이름(`@whatap/design-system`)으로 import 한다. 그 이름을
       **소스로** 해석시킨다 — 기본 self-reference 해석은 package.json `types` 를 따라
       `dist/*.d.ts` 를 보는데, dist 는 gitignore 라 CI 의 fresh 체크아웃에는 없고
       (typecheck 는 build:lib 앞에 돈다) 로컬에서는 낡은 빌드가 남아 **API 를 바꿔도
       타입 오류가 안 잡히는** 반대 문제가 생긴다. 둘 다 소스를 가리키면 사라진다. */
    "paths": {
      "@whatap/design-system": ["./src/index.ts"],
      "@whatap/design-system/widget": ["./src/widget/index.ts"]
    }
  },
  "include": ["src", "stories", ".storybook"]
}
